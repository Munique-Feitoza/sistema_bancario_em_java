# Copie para .env (git-ignored) e ajuste ao seu ambiente:
#   cp .env.example .env
# Em producao, gere um segredo unico e forte:
#   openssl rand -base64 48

# Segredo de assinatura do JWT (HS256) — minimo 32 bytes.
# Valor apenas de exemplo: TROQUE em qualquer ambiente real.
JWT_SECRET=<gere localmente com: openssl rand -base64 48>

# Credenciais do PostgreSQL local (docker-compose)
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
